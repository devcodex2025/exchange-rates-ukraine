# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram relay for the advertising form (api/contact):
# bot token from @BotFather, and the chat id the requests are delivered to.
# Leave empty locally to simulate the 503 "not configured" branch.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
